      "binaryDir": "${sourceDir}/out/agent-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/DM-Agent-x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-agent-x64",
